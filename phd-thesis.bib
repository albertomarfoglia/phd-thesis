	keywords = {Machine learning, Deep learning, Trustworthy AI, Explainable AI, Cognitive reasoning, Neurosymbolic AI, Reasoning},
	pages = {12387--12406},
	file = {Full Text PDF:C\:\\Users\\amarf\\Zotero\\storage\\88MRLEAG\\Garcez e Lamb - 2023 - Neurosymbolic AI the 3rd wave.pdf:application/pdf},
}

