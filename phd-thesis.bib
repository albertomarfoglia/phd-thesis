	month = jan,
	year = {2023},
	keywords = {Review, Health, Interpretability, Explainable artificial intelligence (XAI), ML Methods},
	pages = {101286},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\amarf\\Zotero\\storage\\INCDJ7F9\\S Band et al. - 2023 - Application of explainable artificial intelligence in medical health A systematic review of interpr.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\amarf\\Zotero\\storage\\8BKPN7PI\\S2352914823001302.html:text/html},
