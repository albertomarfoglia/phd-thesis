@article{amri_data-driven_2023,
	title = {The {Data}-{Driven} {Future} of {Healthcare}: {A} {Review}},
	volume = {2023},
	copyright = {Copyright (c) 2023 Muhammad Miftahul Amri, Saad Abas Abed},
	issn = {2958-6453},
	shorttitle = {The {Data}-{Driven} {Future} of {Healthcare}},
	url = {https://mesopotamian.press/journals/index.php/bigdata/article/view/95},
	doi = {10.58496/MJBD/2023/010},
	abstract = {The future of disease detection, treatment, and prevention may very well lie in data-driven healthcare. Here, we take stock of where things stand and highlight certain emerging issues and long-standing difficulties. We looked at all the research that has been published on the topic of data-driven healthcare decision-making. Our research shows that the use of data in healthcare has already improved patient care and results. However, there are substantial obstacles that must be overcome, such as the need to more effectively integrate data from multiple sources, as well as issues with data quality, privacy, and security. Furthermore, healthcare data use raises significant ethical concerns. We examine what these results mean for the future of data-driven healthcare and offer suggestions on where future research should focus. We conclude that data-driven healthcare has the potential to transform healthcare delivery and enhance patient outcomes, but that the inherent difficulties and dangers of this approach must be carefully considered.},
	language = {en},
	urldate = {2024-09-26},
	journal = {Mesopotamian Journal of Big Data},
	author = {Amri, Muhammad Miftahul and Abed, Saad Abas},
	month = jun,
	year = {2023},
	keywords = {Data-Driven},
	pages = {68--74},
	file = {Full Text PDF:/home/albertomarfoglia/snap/zotero-snap/common/Zotero/storage/72UGSID9/Amri and Abed - 2023 - The Data-Driven Future of Healthcare A Review.pdf:application/pdf},
}

@article{engstrom_impact_2023,
	title = {The impact of transition to a digital hospital on medication errors ({TIME} study)},
	volume = {6},
	copyright = {2023 The Author(s)},
	issn = {2398-6352},
	url = {https://www.nature.com/articles/s41746-023-00877-w},
	doi = {10.1038/s41746-023-00877-w},
	abstract = {Digital transformation in healthcare improves the safety of health systems. Within our health service, a new digital hospital has been established and two wards from a neighbouring paper-based hospital transitioned into the new digital hospital. This created an opportunity to evaluate the impact of complete digital transformation on medication safety. Here we discuss the impact of transition from a paper-based to digital hospital on voluntarily reported medication incidents and prescribing errors. This study utilises an interrupted time-series design and takes place across two wards as they transition from a paper to a digital hospital. Two data sources are used to assess impacts on medication incidents and prescribing errors: (1) voluntarily reported medication incidents and 2) a chart audit of medications prescribed on the study wards. The chart audit collects data on procedural, dosing and therapeutic prescribing errors. There are 588 errors extracted from incident reporting software during the study period. The average monthly number of errors reduces from 12.5 pre- to 7.5 post-transition (p {\textless} 0.001). In the chart audit, 5072 medication orders are reviewed pre-transition and 3699 reviewed post-transition. The rates of orders with one or more error reduces significantly after transition (52.8\% pre- vs. 15.7\% post-, p {\textless} 0.001). There are significant reductions in procedural (32.1\% pre- vs. 1.3\% post-, p {\textless} 0.001), and dosing errors (32.3\% pre- vs. 14\% post-, p {\textless} 0.001), but not therapeutic errors (0.6\% pre- vs. 0.7\% post-, p = 0.478). Transition to a digital hospital is associated with reductions in voluntarily reported medication incidents and prescribing errors.},
	language = {en},
	number = {1},
	urldate = {2024-09-26},
	journal = {npj Digital Medicine},
	author = {Engstrom, Teyl and McCourt, Elizabeth and Canning, Martin and Dekker, Katharine and Voussoughi, Panteha and Bennett, Oliver and North, Angela and Pole, Jason D. and Donovan, Peter J. and Sullivan, Clair},
	month = jul,
	year = {2023},
	note = {Publisher: Nature Publishing Group},
	keywords = {Health care, Health services},
	pages = {1--9},
	file = {Full Text PDF:/home/albertomarfoglia/snap/zotero-snap/common/Zotero/storage/C3CFMFCJ/Engstrom et al. - 2023 - The impact of transition to a digital hospital on .pdf:application/pdf},
}

@article{johnson_precision_2021,
