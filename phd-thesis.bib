	month = may,
	year = {2023},
	keywords = {Artificial Intelligence, Biomedicine, Diseases, Drugs, Healthcare Knowledge Graph, Knowledge graph, Knowledge graph construction, Survey},
	pages = {81},
	file = {Full Text PDF:/home/albertomarfoglia/snap/zotero-snap/common/Zotero/storage/W958PMKS/Abu-Salih et al. - 2023 - Healthcare knowledge graph construction A systema.pdf:application/pdf},
}

